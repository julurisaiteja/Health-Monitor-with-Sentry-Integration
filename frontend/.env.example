# Frontend Environment Variables
# Copy this file to .env and fill in your values

# Sentry Configuration
VITE_SENTRY_DSN=your_frontend_sentry_dsn_here
VITE_SENTRY_RELEASE=health-monitor-frontend@1.1.1

# Sentry CLI (for release scripts - used by vite.config.js)
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
SENTRY_ORG=your_sentry_org_slug_here
SENTRY_PROJECT=health-monitor-frontend
